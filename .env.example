# --- TMDB (https://www.themoviedb.org/settings/api) ---
# Renseigne l'un des deux : la clé v3 ou le jeton de lecture v4.
TMDB_API_KEY=
TMDB_READ_TOKEN=

# --- Letterboxd ---
NEXT_PUBLIC_LETTERBOXD_USER=adelkl

# --- Firebase (Console > Paramètres du projet > Vos applications > Web) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Profil public (consultable sans connexion) ---
# UID Firebase du propriétaire (Console > Authentication > Utilisateurs)
NEXT_PUBLIC_PUBLIC_UID=
NEXT_PUBLIC_PUBLIC_HANDLE=adelkl
NEXT_PUBLIC_PUBLIC_NAME=Adel

# --- Notifications push ---
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://adel-films-series.vercel.app
# Secret partagé avec la tâche planifiée Vercel
CRON_SECRET=
# Compte de service Firebase (JSON sur une ligne) : lecture des abonnements côté serveur
FIREBASE_SERVICE_ACCOUNT=
